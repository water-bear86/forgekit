{
  "schema": "forgekit.project-pack.v1",
  "projectId": "forgekit-template",
  "displayName": "ForgeKit Template Pass",
  "engineName": "ForgeKit",
  "issuerName": "ForgeKit Procedure Lab",
  "externalBaseUrl": "https://forgekit.example",
  "token": {
    "mint": "REPLACE_WITH_PROJECT_TOKEN_MINT",
    "symbol": "$TOKEN",
    "decimals": 6,
    "programId": "TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb",
    "dexScreenerPair": ""
  },
  "offers": [
    {
      "id": "standard",
      "label": "Standard Forge",
      "enabled": true,
      "public": true,
      "targetUsd": 2.5,
      "opsReserveUsd": 0.35,
      "minBurnUiAmount": 1,
      "maxBurnUiAmount": 100000,
      "royaltyBasisPoints": 500,
      "mintMode": "core",
      "rarity": {
        "maxBoost": 0.8,
        "boostCurve": 0.22
      }
    },
    {
      "id": "operator",
      "label": "Operator Mint",
      "enabled": true,
      "public": false,
      "targetUsd": 0,
      "opsReserveUsd": 0,
      "minBurnUiAmount": 0,
      "maxBurnUiAmount": 0,
      "royaltyBasisPoints": 500,
      "mintMode": "admin_free",
      "rarity": {
        "maxBoost": 0.8,
        "boostCurve": 0.22
      }
    }
  ],
  "modifier": {
    "label": "Modifier Score",
    "source": "signed_claim",
    "maxBoost": 0.8,
    "boostCurve": 0.22,
    "requiredForPublicMint": false
  },
  "nft": {
    "collectionAddress": "REPLACE_WITH_CORE_COLLECTION",
    "royaltyCreator": "REPLACE_WITH_ROYALTY_CREATOR",
    "sellerFeeBasisPoints": 500,
    "nameTemplate": "{{displayName}} #{{number}}",
    "descriptionTemplate": "{{displayName}} generated by ForgeKit.",
    "externalUrlTemplate": "{{externalBaseUrl}}/asset/{{assetId}}"
  },
  "artPack": {
    "canvas": {
      "width": 512,
      "height": 320
    },
    "assetRoot": "./",
    "manifest": "./trait-manifest.json",
    "outputFormat": "png"
  },
  "copy": {
    "projectPackLabel": "Template Pack",
    "modifierLabel": "Modifier Score",
    "tagline": "Procedural NFT engine with live-chain seasoning.",
    "successLabel": "FORGEKIT VERIFIED",
    "warningLabels": [
      "Preview art is not production art.",
      "Mainnet minting requires explicit operator approval."
    ]
  },
  "compliance": {
    "status": "template_only",
    "publicMintAllowed": false,
    "requiresAssetOwnershipAttestation": true,
    "requiresDevnetMintBeforeMainnet": true,
    "allowedAssetExtensions": [".png", ".svg"],
    "allowedAssetRoots": ["./"],
    "requiredMetadataFields": [
      "name",
      "description",
      "image",
      "external_url",
      "attributes",
      "properties.wallet",
      "properties.seed",
      "properties.traitPackId"
    ],
    "operatorNotes": "Copy this template into a project-specific pack, replace token and collection values, attach owned art, then run manifest validation before public activation."
  }
